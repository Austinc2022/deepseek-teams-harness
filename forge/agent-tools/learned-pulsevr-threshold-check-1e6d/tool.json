        "type": "number"
      },
      "addressable_base": {
        "type": "number"
      },
      "claimed_subscribers": {
        "type": "number"
      },
      "monthly_churn_pct": {
        "type": "number"
      },
      "vat_pct_on_eu": {
        "type": "number"
      },
      "eu_share": {
        "type": "number"
      }
    },
    "required": [
      "price_per_month",
      "platform_fee_pct",
      "addressable_base"
    ]
  },
  "example": {
    "price_per_month": 9.99,
    "platform_fee_pct": 30,
    "addressable_base": 4080000,
