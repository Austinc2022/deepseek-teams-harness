    "type": "object",
    "properties": {
      "monthlyPrice": {
        "type": "number"
      },
      "hardwarePrice": {
        "type": "number"
      },
      "waitlist": {
        "type": "number"
      },
      "deposits": {
        "type": "number"
      },
      "retainedPayers": {
        "type": "number"
      },
      "targets": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "required": [
      "monthlyPrice",
      "hardwarePrice",
      "waitlist",
      "deposits",
      "retainedPayers",
      "targets"
    ]
  },
  "example": {
    "monthlyPrice": 19,
    "hardwarePrice": 129,
