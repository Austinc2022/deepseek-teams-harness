    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "height_m": {
              "type": "number"
            },
            "distance_m": {
              "type": "number"
            }
          },
          "required": [
            "name",
            "height_m",
            "distance_m"
          ]
        }
      },
      "target": {
        "type": "object",
        "properties": {
          "angle_deg": {
            "type": "number"
          },
          "distance_m": {
            "type": "number"
          }
        },
        "required": [
          "angle_deg",
          "distance_m"
        ]
      }
    },
    "required": [
      "items"
    ]
  },
