{
  "name": "@local/group-hq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Group headquarters: companies on this or other computers join with an invite code; the headquarters sees what each shares, sends directives and policies within the authority each company gives it, and has a group CEO and an independent review team.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "lib/*.js", "bin/*.js", "ui/index.html", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  }
}
