{
  "name": "@local/agent-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Configurable agents, teams and multi-agent orchestrations on Claude Code.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": { "forge": "./bin/forge.js" },
  "files": ["index.js", "lib/*.js", "bin/*.js", "ui/index.html", "container/Dockerfile", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
