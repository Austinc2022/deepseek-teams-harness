{
  "name": "@local/company-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Company page in the DeepSeek Harness web UI: budget and spend, decisions waiting for the owner, the initiative pipeline and gate results, execution orders, the organisation, engine health, cycles, hires and the charter.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "lib/*.js", "ui/index.html", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  }
}
