# Dependencies
node_modules/

# Local DeepSeek harness state (contains credentials, tokens, sessions, logs)
.dsh-home/

# Secrets
.env
.env.*
*.pem
*credentials*
*-token

# OS / editor
.DS_Store
*.log

# Agent Forge runtime data (personal runs, memory, sessions, caches, tokens)
forge/runs/
forge/memory/
forge/.cache/
forge/workspaces/
forge/reports/
forge/agent-homes/
forge/mcp/

# Local Claude Code settings
.claude/settings.local.json

# Personal chat history
forge/chats/
forge/chat-projects.json
forge/chat-project-agents.json

# CLI workbench worktrees (your working copies)
forge/worktrees/

# Project board data (your projects, tasks and run links)
forge/projects/

# r.OS client project setup (private: WhatsApp IDs, client rules) - kept local, never published
forge/agents/ros-*.yaml
forge/teams/t[0-9][0-9]-*.yaml
forge/orchestrations/ros-*.js
forge/orchestrations/lib/
forge/skills/ros-*/

# Super team chats (your conversations and their configuration)
forge/super-teams/
forge/super-team-projects.json

# Private crypto quant engine and its agent teams - kept local, never published
quant/
forge/agents/quant-*.yaml
forge/teams/quant-*.yaml
forge/orchestrations/quant-*.js
forge/skills/quant-*/
scripts/schedule-interval.sh

# Company (CEO) state: charter, initiatives, decisions, spend ledger, briefs - kept local, never published
forge/company/
forge/super-agent/

# Agents and teams generated by a company profile (./company-cli setup, ./super-cli setup): they hold
# absolute paths of this machine and are rebuilt from plugins/company/profiles/ - kept local
forge/agents/vr-*.yaml
forge/teams/vr-*.yaml
forge/agents/*.yaml.bak

# Company knowledge store (SQLite, runtime data)
forge/knowledge/

# Other companies on this machine (docs/COMPANIES.md): their whole forge home, runs, memory and state
/companies/
